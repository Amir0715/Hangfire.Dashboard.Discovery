<div class="drawer__overlay @(_isOpen ? "drawer__overlay--open" : "")"
     @onclick="Close"
     @onkeydown="HandleOverlayKeyDown"
     tabindex="0"
     role="button"
     aria-label="Close drawer">
</div>

<div class="drawer @GetDrawerClasses()"
     style="@GetDrawerStyles()"
     role="dialog"
     aria-modal="true"
     aria-labelledby="drawer-title-@_drawerId"
     @ref="_drawerElement">

    <div class="drawer__body">
        <header class="drawer__header">
            <h3 id="drawer-title-@_drawerId" class="drawer__title">
                @Title
            </h3>
            <button class="drawer__close-btn"
                    @onclick="Close"
                    aria-label="Close drawer"
                    type="button">
                <span aria-hidden="true">✕</span>
            </button>
        </header>

        <main class="drawer__content">
            @ChildContent
        </main>
    </div>
</div>

@code {
    private ElementReference _drawerElement;
    private string _drawerId = Guid.NewGuid().ToString("N");
    private bool _isOpen;
    private bool _shouldAnimate;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string Title { get; set; } = "Drawer";

    [Parameter]
    public string Width { get; set; } = "400px";

    [Parameter]
    public DrawerPosition Position { get; set; } = DrawerPosition.Right;

    [Parameter]
    public DrawerSize Size { get; set; } = DrawerSize.Custom;

    [Parameter]
    public bool Dismissable { get; set; } = true;

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public bool IsOpen
    {
        get => _isOpen;
        set
        {
            if (_isOpen != value)
            {
                _isOpen = value;
                _shouldAnimate = true;
                IsOpenChanged.InvokeAsync(value);
                StateHasChanged();
            }
        }
    }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isOpen && _shouldAnimate)
        {
            _shouldAnimate = false;

            // Focus management for accessibility
            await Task.Delay(50); // Small delay for animation

            // In a real app, you might want to focus the first focusable element
        }
    }

    private string GetDrawerClasses()
    {
        var classes = new List<string>();

        if (_isOpen)
            classes.Add("drawer--open");

        classes.Add($"drawer--{Position.ToString().ToLower()}");

        if (Size != DrawerSize.Custom)
            classes.Add($"drawer--{Size.ToString().ToLower()}");

        if (!string.IsNullOrEmpty(Class))
            classes.Add(Class);

        return string.Join(" ", classes);
    }

    private string GetDrawerStyles()
    {
        var styles = new List<string>();

        if (Size == DrawerSize.Custom && !string.IsNullOrEmpty(Width))
        {
            var dimension = Position is DrawerPosition.Left or DrawerPosition.Right ? "width" : "height";
            styles.Add($"{dimension}: {Width}");
        }

        return string.Join("; ", styles);
    }

    private void HandleOverlayKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" || e.Key == "Enter" || e.Key == " ")
        {
            Close();
        }
    }

    private void Close()
    {
        if (Dismissable && IsOpen)
        {
            IsOpen = false;
        }
    }

    public enum DrawerPosition
    {
        Right,
        Left,
        Top,
        Bottom
    }

    public enum DrawerSize
    {
        Custom,
        Small,
        Medium,
        Large,
        Full
    }

}


