@typeparam TItem

<div class="dropdown @(_isFullWidth ? "dropdown--full" : "") @Class">
    <select @ref="_selectElement"
            @bind="SelectedItem"
            @bind:event="onchange"
            @bind:after="HandleChange"
            disabled="@Disabled"
            class="dropdown__select">

        @if (!string.IsNullOrEmpty(Placeholder))
        {
            <option value="" disabled="@(SelectedItem != null)">@Placeholder</option>
        }

        @if (Items?.Any() == true)
        {
            @foreach (var item in Items)
            {
                <option value="@item" disabled="@(IsItemDisabled?.Invoke(item) == true)">
                    @GetItemDisplayText(item)
                </option>
            }
        }
        else
        {
            <option value="" disabled>No options available</option>
        }
    </select>

    <span class="dropdown__arrow">▼</span>
</div>

@code {
    private ElementReference _selectElement;
    private bool _isFullWidth;

    [Parameter]
    public IEnumerable<TItem>? Items { get; set; }

    [Parameter]
    public TItem? SelectedItem { get; set; }

    [Parameter]
    public EventCallback<TItem?> SelectedItemChanged { get; set; }

    [Parameter]
    public Func<TItem, string>? ItemToString { get; set; }

    [Parameter]
    public Func<TItem, bool>? IsItemDisabled { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public bool IsFullWidth { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    protected override void OnInitialized()
    {
        _isFullWidth = IsFullWidth;
    }

    private string GetItemDisplayText(TItem item) => 
        ItemToString?.Invoke(item) ?? item?.ToString() ?? string.Empty;

    private async Task HandleChange()
    {
        // The binding handles the value change, but we can add additional logic here
        await SelectedItemChanged.InvokeAsync(SelectedItem);
    }
}