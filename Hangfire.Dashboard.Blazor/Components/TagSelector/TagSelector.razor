<div class="tag-selector @(FullWidth ? "tag-selector--full" : "") @(Disabled ? "tag-selector--disabled" : "") @Class"
     @onclick="FocusInput"
     @onkeydown="HandleKeyDown"
     role="combobox"
     aria-expanded="@_showDropdown"
     aria-haspopup="listbox">

    @foreach (var tag in SelectedItems)
    {
        <div class="tag-selector__tag">
            <span class="tag-selector__tag-text">@tag</span>
            <button class="tag-selector__remove-btn"
                    @onclick="@(() => RemoveTag(tag))"
                    @onclick:stopPropagation="true"
                    type="button"
                    aria-label="Remove @tag">
                &times;
            </button>
        </div>
    }

    <input @ref="_inputElement"
           type="text"
           class="tag-selector__input"
           placeholder="@(SelectedItems.Any() ? "" : Placeholder)"
           @bind="@_searchText"
           @bind:event="oninput"
           @onfocus="ShowDropdown"
           @onblur="HideDropdown"
           disabled="@Disabled" />

    @if (_showDropdown)
    {
        <div class="tag-selector__dropdown"
             role="listbox"
             aria-label="Suggested tags">
            
            @if (!FilteredItems.Any())
            {
                <div class="tag-selector__empty-state">
                    @NoItemsText
                </div>
            }
            else
            {
                @foreach (var tag in FilteredItems)
                {
                    <div class="tag-selector__dropdown-item"
                         role="option"
                         @onmousedown="@(() => AddTag(tag))">
                        @tag
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public IEnumerable<string> Items { get; set; } = [];

    [Parameter]
    public ICollection<string> SelectedItems { get; set; } = [];

    [Parameter]
    public EventCallback<ICollection<string>> SelectedItemsChanged { get; set; }

    [Parameter]
    public string NoItemsText { get; set; } = "No items found";

    [Parameter]
    public string Placeholder { get; set; } = "Type to search...";

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public bool FullWidth { get; set; }

    [Parameter]
    public bool AllowDuplicates { get; set; }

    [Parameter]
    public int MaxItems { get; set; } = 0;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private ElementReference _inputElement;
    private string _searchText = string.Empty;
    private bool _showDropdown = false;

    private List<string> FilteredItems => Items
        .Where(item => string.IsNullOrEmpty(_searchText) || 
                      item.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
        .Where(item => AllowDuplicates || !SelectedItems.Contains(item))
        .OrderBy(item => item)
        .ToList();

    private async Task FocusInput()
    {
        if (!Disabled)
        {
            await _inputElement.FocusAsync();
        }
    }

    private void ShowDropdown()
    {
        if (!Disabled)
        {
            _showDropdown = true;
        }
    }

    private void HideDropdown()
    {
        _showDropdown = false;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Enter" when _showDropdown && FilteredItems.Any():
                await AddTag(FilteredItems.First());
                break;
                
            case "Escape":
                _showDropdown = false;
                break;
            
            case "Backspace" when string.IsNullOrEmpty(_searchText) && SelectedItems.Any():
                var lastTag = SelectedItems.Last();
                await RemoveTag(lastTag);
                break;
        }
    }

    private async Task AddTag(string tag)
    {
        if (Disabled || string.IsNullOrWhiteSpace(tag)) return;
        
        if (MaxItems > 0 && SelectedItems.Count >= MaxItems)
        {
            return;
        }

        if (!AllowDuplicates && SelectedItems.Contains(tag))
        {
            return;
        }

        SelectedItems.Add(tag);
        _searchText = string.Empty;
        _showDropdown = true;
        
        await FocusInput();
        await SelectedItemsChanged.InvokeAsync(SelectedItems);
    }

    private async Task RemoveTag(string tag)
    {
        if (Disabled) return;
        
        SelectedItems.Remove(tag);
        await SelectedItemsChanged.InvokeAsync(SelectedItems);
        await FocusInput();
    }
}